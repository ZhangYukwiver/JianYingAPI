*.ogg
*.png
*.jpg
*.jpeg
*.webp

# Operating system files
Thumbs.db
Desktop.ini
.DS_Store

# Node port: dependencies stay local; its synthetic test media and oracle drafts
# are generated by node/scripts and are meant to be published
node_modules/
!/node/fixtures/**
